      "code": "def cashflows(perf, terms):\n    import numpy as np\n\n    perf = np.asarray(perf, dtype=float)\n    n_paths = perf.shape[0]\n    n_dates = perf.shape[1]\n    cash = np.zeros((n_paths, n_dates), dtype=float)\n    notional = float(terms[\"notional\"])\n    final_index = int(terms[\"final_index\"])\n    downside = terms[\"downside\"]\n    upside = terms[\"upside\"]\n    buffer = 1.0 - float(downside[\"level\"])\n    gearing = float(downside[\"gearing\"])\n    leverage = 1.0\n    cap = None\n    if upside is not None:\n        leverage = float(upside[\"leverage\"])\n        if upside[\"cap\"] is not None:\n            cap = float(upside[\"cap\"])\n    final_perf = perf[:, final_index, 0]\n    ret = final_perf - 1.0\n    payment = np.zeros(n_paths, dtype=float)\n    positive = ret > 0.0\n    middle = np.logical_and(ret <= 0.0, ret >= -buffer)\n    below = ret < -buffer\n    if np.any(positive):\n        upside_ret = leverage * ret[positive]\n        if cap is not None:\n            upside_ret = np.minimum(upside_ret, cap)\n        payment[positive] = notional * (1.0 + upside_ret)\n    if np.any(middle):\n        payment[middle] = notional * (1.0 + np.abs(ret[middle]))\n    if np.any(below):\n        payment[below] = notional * (1.0 + gearing * (ret[below] + buffer))\n    payment = np.maximum(payment, 0.0)\n    cash[:, final_index] = payment\n    return cash",
